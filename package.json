{
  "name": "obsidian-clicker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "build": "node tools/build.mjs",
    "check": "tsc -p jsconfig.json",
    "simulate:campaign": "node tools/simulate-campaign.mjs",
    "start": "node tools/serve.mjs",
    "simulate": "node tools/simulate-campaign.mjs 1 90",
    "simulate:legacy": "node tools/simulate-active.mjs && node tools/simulate-builds.mjs && node tools/simulate-project.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3"
  }
}
